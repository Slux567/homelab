services:
  prometheus:
    user: 0:0
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/file_sd:/etc/prometheus/file_sd:ro
      - ./prometheus/data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
    networks:
      - infra-net
    labels:
      - "traefik.enable=true"
      # HTTP router 
      - "traefik.http.routers.prometheus.rule=Host(`prometheus.slux-solutions.com`)"
      - "traefik.http.routers.prometheus.entrypoints=web"
      # HTTPS router
      - "traefik.http.routers.prometheus-secure.rule=Host(`prometheus.slux-solutions.com`)"
      - "traefik.http.routers.prometheus-secure.entrypoints=websecure"
      - "traefik.http.routers.prometheus-secure.tls=true"
      - "traefik.http.routers.prometheus-secure.tls.certresolver=cloudflare"
      # Internal HTTP port
      - "traefik.http.services.prometheus.loadbalancer.server.port=9090"
    restart: unless-stopped

  grafana:
    user: 0:0
    image: grafana/grafana:latest
    container_name: grafana
    volumes:
      - ./grafana/data:/var/lib/grafana
    environment:
      - GF_SECURITY_ADMIN_USER={{GRAFANA_ADMIN_USER}}
      - GF_SECURITY_ADMIN_PASSWORD={{GRAFANA_ADMIN_PASSWORD}}
      - GF_USERS_ALLOW_SIGN_UP=false
    networks:
      - infra-net
    labels:
      - "traefik.enable=true"
      # HTTP router 
      - "traefik.http.routers.grafana.rule=Host(`grafana.slux-solutions.com`)"
      - "traefik.http.routers.grafana.entrypoints=web"
      # HTTPS router
      - "traefik.http.routers.grafana-secure.rule=Host(`grafana.slux-solutions.com`)"
      - "traefik.http.routers.grafana-secure.entrypoints=websecure"
      - "traefik.http.routers.grafana-secure.tls=true"
      - "traefik.http.routers.grafana-secure.tls.certresolver=cloudflare"
      # Internal HTTP port
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"
    restart: unless-stopped

networks:
  infra-net:
    name: infra-net
    external: true