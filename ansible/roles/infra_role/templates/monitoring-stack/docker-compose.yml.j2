services:
  prometheus:
    user: 0:0
    image: prom/prometheus:latest
    container_name: prometheus
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/file_sd:/etc/prometheus/file_sd:ro
      - ./prometheus/data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
    networks:
      - infra-net
    labels:
      - "traefik.enable=true"
      # HTTP router 
      - "traefik.http.routers.prometheus.rule=Host(`prometheus.slux-solutions.com`)"
      - "traefik.http.routers.prometheus.entrypoints=web"
      # HTTPS router
      - "traefik.http.routers.prometheus-secure.rule=Host(`prometheus.slux-solutions.com`)"
      - "traefik.http.routers.prometheus-secure.entrypoints=websecure"
      - "traefik.http.routers.prometheus-secure.tls=true"
      - "traefik.http.routers.prometheus-secure.tls.certresolver=cloudflare"
      # Internal HTTP port
      - "traefik.http.services.prometheus.loadbalancer.server.port=9090"
    restart: unless-stopped

  grafana:
    user: 0:0
    image: grafana/grafana:latest
    container_name: grafana
    volumes:
      - ./grafana/data:/var/lib/grafana
    environment:
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: "authentik"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: {{ AUTHENTIK_GRAFANA_CLIENT_ID }}
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: {{ AUTHENTIK_GRAFANA_CLIENT_SECRET }}
      GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: "https://authentik.slux-solutions.com/application/o/authorize/"
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "https://authentik.slux-solutions.com/application/o/token/"
      GF_AUTH_GENERIC_OAUTH_API_URL: "https://authentik.slux-solutions.com/application/o/userinfo/"
      GF_AUTH_SIGNOUT_REDIRECT_URL: "https://authentik.slux-solutions.com/application/o/grafana/end-session/"
      GF_AUTH_OAUTH_AUTO_LOGIN: "true"
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups, 'Grafana Admin') && 'Admin' || contains(groups, 'Grafana Editor') && 'Editor' || 'Viewer'"
      GF_SERVER_ROOT_URL: "https://grafana.slux-solutions.com"
    networks:
      - infra-net
    labels:
      - "traefik.enable=true"
      # HTTP router 
      - "traefik.http.routers.grafana.rule=Host(`grafana.slux-solutions.com`)"
      - "traefik.http.routers.grafana.entrypoints=web"
      # HTTPS router
      - "traefik.http.routers.grafana-secure.rule=Host(`grafana.slux-solutions.com`)"
      - "traefik.http.routers.grafana-secure.entrypoints=websecure"
      - "traefik.http.routers.grafana-secure.tls=true"
      - "traefik.http.routers.grafana-secure.tls.certresolver=cloudflare"
      # Internal HTTP port
      - "traefik.http.services.grafana.loadbalancer.server.port=3000"
    restart: unless-stopped

networks:
  infra-net:
    name: infra-net
    external: true