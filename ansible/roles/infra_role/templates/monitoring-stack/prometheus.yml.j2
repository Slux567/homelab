global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'node_exporter'
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/hosts.yml
    relabel_configs:
      - source_labels: [__address__]
        regex: '^(.*)$'
        target_label: __address__
        replacement: '${1}:9100'  # Append node_exporter port