{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch and digest updates directly to main (no PR)",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "requiredStatusChecks": null
    },
    {
      "description": "Group all minor version bumps into a single PR, no automerge",
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor Patches",
      "automerge": false
    },
    {
      "description": "Open a separate PR per major version bump, no automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
