{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "flux": {
    "managerFilePatterns": ["/kubernetes/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Auto-merge patch and digest updates directly to main (no PR)",
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Group all minor version bumps into a single PR, no automerge",
      "matchUpdateTypes": ["minor"],
      "groupName": "Minor Patches",
      "automerge": false
    },
    {
      "description": "Open a separate PR per major version bump, no automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container image repository+tag pairs in app-template HelmRelease values",
      "managerFilePatterns": ["/kubernetes/.+\\.yaml$/"],
      "matchStrings": [
        "repository: (?<depName>[^\\s]+)\\n\\s+tag: \"?(?<currentValue>[^@\"\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}